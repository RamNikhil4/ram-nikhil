<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <title>New Message from Your Portfolio</title>
  <!--[if mso]>
  <noscript>
    <xml>
      <o:OfficeDocumentSettings>
        <o:PixelsPerInch>96</o:PixelsPerInch>
      </o:OfficeDocumentSettings>
    </xml>
  </noscript>
  <![endif]-->
  <style type="text/css">
    /* Reset & Resilient Rendering */
    body, table, td, a { -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }
    table, td { mso-table-lspace: 0pt; mso-table-rspace: 0pt; }
    img { -ms-interpolation-mode: bicubic; border: 0; height: auto; line-height: 100%; outline: none; text-decoration: none; }
    table { border-collapse: collapse !important; }
    body { height: 100% !important; margin: 0 !important; padding: 0 !important; width: 100% !important; background-color: #050505; }

    /* Web Fonts */
    @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;600;700&family=Inter:wght@400;500;600;700&family=Geist+Mono:wght@400;500;600&display=swap');

    /* Interactive States & Highlights */
    .btn-hover:hover {
      background-color: #fcd34d !important;
      box-shadow: 0 6px 30px rgba(251, 191, 36, 0.45) !important;
      transform: translateY(-1px) !important;
    }
    .link-hover:hover {
      color: #fafaf9 !important;
      text-decoration: underline !important;
    }

    /* Dark Mode Preferences */
    @media (prefers-color-scheme: dark) {
      .email-bg { background-color: #020202 !important; }
      .card-bg { background-color: #0b0b0c !important; }
    }

    /* Responsive Grid */
    @media screen and (max-width: 600px) {
      .email-container { width: 100% !important; max-width: 100% !important; }
      .padding-mobile { padding-left: 20px !important; padding-right: 20px !important; padding-top: 28px !important; padding-bottom: 28px !important; }
      .field-padding-mobile { padding: 14px 16px !important; }
      .cta-mobile { width: 100% !important; display: block !important; }
    }
  </style>
</head>
<body style="margin: 0; padding: 0; background-color: #050505; font-family: 'Inter', system-ui, -apple-system, sans-serif;">

  <!-- Invisible Preheader text for notifications -->
  <div style="display: none; font-size: 1px; color: #050505; line-height: 1px; max-height: 0px; max-width: 0px; opacity: 0; overflow: hidden; mso-hide: all;">
    ✦ New inquiry from <%= sender_name %>: "<%= message_body.substring(0, 80) %>..."
  </div>

  <!-- Background Wrapper -->
  <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="background-color: #050505;" class="email-bg">
    <tr>
      <td style="padding: 48px 16px 64px 16px;">

        <!-- Email Container -->
        <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="600" align="center" class="email-container" style="max-width: 600px; margin: 0 auto;">

          <!-- ======== BRAND HEADER ======== -->
          <tr>
            <td style="padding: 0 0 36px 0; text-align: center;">
              <!-- Elegant brand glow line -->
              <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="160" align="center">
                <tr>
                  <td style="height: 2px; background: linear-gradient(90deg, transparent, #fbbf24 50%, transparent); font-size: 0; line-height: 0;">&nbsp;</td>
                </tr>
              </table>
              <div style="height: 28px; font-size: 0;">&nbsp;</div>
              
              <!-- Brand Name -->
              <h1 style="margin: 0; font-family: 'Space Grotesk', 'Arial Black', sans-serif; font-size: 32px; font-weight: 700; color: #fde68a; letter-spacing: -1px; line-height: 1;">
                Ram Nikhil<span style="color: #fbbf24;">.</span>
              </h1>
              <p style="margin: 8px 0 0 0; font-family: 'Geist Mono', 'Courier New', monospace; font-size: 11px; color: #78716c; letter-spacing: 4px; text-transform: uppercase; font-weight: 500;">
                Portfolio Intelligence System
              </p>
            </td>
          </tr>

          <!-- ======== MAIN GLASS CARD ======== -->
          <tr>
            <td class="card-bg" style="background-color: #0f0f11; border: 1px solid rgba(251, 191, 36, 0.16); border-radius: 20px; box-shadow: 0 20px 50px rgba(0,0,0,0.5); overflow: hidden;">

              <!-- Top Decorative Gradient Border (Midnight Champagne signature glow) -->
              <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                <tr>
                  <td style="height: 4px; background: linear-gradient(90deg, #b45309 0%, #fbbf24 35%, #fde68a 50%, #fbbf24 65%, #b45309 100%); font-size: 0; line-height: 0;">&nbsp;</td>
                </tr>
              </table>

              <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                <tr>
                  <td style="padding: 44px 44px 44px 44px;" class="padding-mobile">

                    <!-- Announcement Header -->
                    <table role="presentation" cellspacing="0" cellpadding="0" border="0" style="margin-bottom: 24px;">
                      <tr>
                        <td style="background: linear-gradient(135deg, rgba(251, 191, 36, 0.12), rgba(180, 83, 9, 0.04)); border: 1px solid rgba(251, 191, 36, 0.22); border-radius: 30px; padding: 6px 16px;">
                          <span style="font-family: 'Geist Mono', 'Courier New', monospace; font-size: 11px; font-weight: 600; color: #fbbf24; letter-spacing: 2px; text-transform: uppercase; display: inline-block;">✦ INBOUND TRANSMISSION ✦</span>
                        </td>
                      </tr>
                    </table>

                    <h2 style="margin: 0 0 12px 0; font-family: 'Space Grotesk', sans-serif; font-size: 28px; font-weight: 700; color: #fafaf9; line-height: 1.25; letter-spacing: -0.5px;">
                      A new project inquiry has landed.
                    </h2>
                    
                    <p style="margin: 0 0 36px 0; font-family: 'Inter', sans-serif; font-size: 15px; color: #a8a29e; line-height: 1.6; font-weight: 400;">
                      A visitor has left a response via your portfolio contact console. Here are the processed message details:
                    </p>

                    <!-- INFO GRID (SENDER / EMAIL) -->
                    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin-bottom: 24px;">
                      <tr>
                        <!-- Sender Name Column -->
                        <td width="50%" class="stack-column" style="vertical-align: top; padding-right: 10px; padding-bottom: 16px;">
                          <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                            <tr>
                              <td class="field-padding-mobile" style="background-color: rgba(255, 255, 255, 0.02); border: 1px solid rgba(251, 191, 36, 0.08); border-radius: 12px; padding: 18px 20px;">
                                <span style="font-family: 'Geist Mono', monospace; font-size: 10px; color: #78716c; letter-spacing: 2px; text-transform: uppercase; font-weight: 500; display: block; margin-bottom: 6px;">Sender Name</span>
                                <span style="font-family: 'Inter', sans-serif; font-size: 16px; color: #fafaf9; font-weight: 600; letter-spacing: -0.2px;"><%= sender_name %></span>
                              </td>
                            </tr>
                          </table>
                        </td>
                        <!-- Sender Email Column -->
                        <td width="50%" class="stack-column" style="vertical-align: top; padding-left: 10px; padding-bottom: 16px;">
                          <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                            <tr>
                              <td class="field-padding-mobile" style="background-color: rgba(255, 255, 255, 0.02); border: 1px solid rgba(251, 191, 36, 0.08); border-radius: 12px; padding: 18px 20px;">
                                <span style="font-family: 'Geist Mono', monospace; font-size: 10px; color: #78716c; letter-spacing: 2px; text-transform: uppercase; font-weight: 500; display: block; margin-bottom: 6px;">Email Address</span>
                                <a href="mailto:<%= sender_email %>" class="link-hover" style="font-family: 'Inter', sans-serif; font-size: 16px; color: #fbbf24; font-weight: 600; text-decoration: none; letter-spacing: -0.2px; display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"><%= sender_email %></a>
                              </td>
                            </tr>
                          </table>
                        </td>
                      </tr>
                    </table>

                    <!-- MESSAGE CONTAINER (Blockquote style) -->
                    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin-bottom: 40px;">
                      <tr>
                        <td style="background: linear-gradient(180deg, rgba(251, 191, 36, 0.04) 0%, transparent 100%); border-left: 3px solid #fbbf24; border-top: 1px solid rgba(251, 191, 36, 0.08); border-right: 1px solid rgba(251, 191, 36, 0.08); border-bottom: 1px solid rgba(251, 191, 36, 0.08); border-radius: 4px 16px 16px 4px; padding: 24px 28px;">
                          <span style="font-family: 'Geist Mono', monospace; font-size: 10px; color: #fbbf24; letter-spacing: 2.5px; text-transform: uppercase; font-weight: 600; display: block; margin-bottom: 12px;">Transmission Payload</span>
                          
                          <!-- Quote indicator -->
                          <div style="font-family: 'Space Grotesk', serif; font-size: 40px; color: rgba(251, 191, 36, 0.15); line-height: 0; margin-top: 10px; margin-bottom: -10px;">“</div>
                          
                          <p style="margin: 0; font-family: 'Inter', sans-serif; font-size: 15px; color: #e2e1df; line-height: 1.8; font-weight: 400; font-style: italic;">
                            <%- message_body %>
                          </p>
                          
                          <div style="font-family: 'Space Grotesk', serif; font-size: 40px; color: rgba(251, 191, 36, 0.15); line-height: 0; text-align: right; margin-top: 10px; margin-bottom: -15px;">”</div>
                        </td>
                      </tr>
                    </table>

                    <!-- CALL TO ACTION BUTTON (Highly Interactive) -->
                    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                      <tr>
                        <td align="center">
                          <table role="presentation" cellspacing="0" cellpadding="0" border="0" class="cta-mobile">
                            <tr>
                              <td class="btn-hover" style="border-radius: 14px; background-color: #fbbf24; text-align: center; box-shadow: 0 4px 20px rgba(251, 191, 36, 0.25); transition: all 300ms ease;">
                                <a href="mailto:<%= sender_email %>?subject=Re: Portfolio Contact&body=Hi <%= sender_name %>,%0D%0A%0D%0AThank you for reaching out! I received your inquiry regarding..." target="_blank" style="display: inline-block; padding: 16px 40px; font-family: 'Inter', sans-serif; font-size: 15px; font-weight: 700; color: #050505; text-decoration: none; letter-spacing: 0.5px; text-transform: uppercase;">
                                  Initiate Connection &rarr;
                                </a>
                              </td>
                            </tr>
                          </table>
                        </td>
                      </tr>
                    </table>

                  </td>
                </tr>
              </table>

            </td>
          </tr>

          <!-- ======== SYSTEM METADATA ======== -->
          <tr>
            <td style="padding: 28px 0; text-align: center;">
              <table role="presentation" cellspacing="0" cellpadding="0" border="0" align="center" style="background-color: rgba(255,255,255,0.01); border: 1px solid rgba(255,255,255,0.04); border-radius: 30px; padding: 6px 18px;">
                <tr>
                  <td>
                    <span style="font-family: 'Geist Mono', 'Courier New', monospace; font-size: 11px; color: #78716c; letter-spacing: 1px;">
                      ✦ SYSTEM STAMP: <%= date %> @ <%= time %>
                    </span>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- ======== PREMIUM BRANDED FOOTER ======== -->
          <tr>
            <td style="padding: 8px 0 0 0; text-align: center;">
              <!-- Footer divider line -->
              <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="80" align="center">
                <tr>
                  <td style="height: 1px; background: linear-gradient(90deg, transparent, rgba(251, 191, 36, 0.4), transparent); font-size: 0; line-height: 0;">&nbsp;</td>
                </tr>
              </table>
              <div style="height: 24px; font-size: 0;">&nbsp;</div>

              <!-- Social Connectivity Links -->
              <table role="presentation" cellspacing="0" cellpadding="0" border="0" align="center">
                <tr>
                  <td style="padding: 0 10px;">
                    <a href="https://github.com/RamNikhil4" target="_blank" style="display: inline-block; width: 40px; height: 40px; background-color: rgba(255,255,255,0.04); border: 1px solid rgba(251, 191, 36, 0.12); border-radius: 10px; text-align: center; line-height: 42px; text-decoration: none;">
                      <img src="https://cdn.jsdelivr.net/npm/simple-icons@v9/icons/github.svg" alt="GitHub" width="18" height="18" style="filter: brightness(0) invert(0.85); vertical-align: middle;">
                    </a>
                  </td>
                  <td style="padding: 0 10px;">
                    <a href="https://www.linkedin.com/in/ram-nikhil-teja-budide/" target="_blank" style="display: inline-block; width: 40px; height: 40px; background-color: rgba(255,255,255,0.04); border: 1px solid rgba(251, 191, 36, 0.12); border-radius: 10px; text-align: center; line-height: 42px; text-decoration: none;">
                      <img src="https://cdn.jsdelivr.net/npm/simple-icons@v9/icons/linkedin.svg" alt="LinkedIn" width="18" height="18" style="filter: brightness(0) invert(0.85); vertical-align: middle;">
                    </a>
                  </td>
                  <td style="padding: 0 10px;">
                    <a href="mailto:ramnikhil312@gmail.com" style="display: inline-block; width: 40px; height: 40px; background-color: rgba(255,255,255,0.04); border: 1px solid rgba(251, 191, 36, 0.12); border-radius: 10px; text-align: center; line-height: 38px; text-decoration: none; font-size: 16px; color: #a8a29e; font-weight: bold;">
                      ✉
                    </a>
                  </td>
                </tr>
              </table>

              <div style="height: 24px; font-size: 0;">&nbsp;</div>

              <!-- Copyright -->
              <p style="margin: 0; font-family: 'Inter', sans-serif; font-size: 13px; color: #78716c; font-weight: 400;">
                &copy; 2026 Ram Nikhil Teja Budide. All rights reserved.
              </p>
              <p style="margin: 6px 0 0 0; font-family: 'Inter', sans-serif; font-size: 12px; color: #78716c; font-weight: 500;">
                <a href="https://ramnikhil.dev" class="link-hover" style="color: #fbbf24; text-decoration: none; font-weight: 600;">ramnikhil.dev</a> &bull; Portfolio Console
              </p>

              <div style="height: 32px; font-size: 0;">&nbsp;</div>
              <!-- Bottom terminal line -->
              <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100" align="center">
                <tr>
                  <td style="height: 2px; background: linear-gradient(90deg, transparent, #fbbf24, transparent); font-size: 0; line-height: 0;">&nbsp;</td>
                </tr>
              </table>
            </td>
          </tr>

        </table>
        <!-- /email-container -->

      </td>
    </tr>
  </table>

</body>
</html>
